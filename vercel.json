{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 300,
        "runtime": "python3.12",
        "excludeFiles": "{data/**,data_batch/**,tmp/**,tmp_face/**,tests/**,issues/**}"
      }
    }
  ],
  "env": {
    "FACE_CLUSTERING_ENABLED": "true",
    "FACE_MODEL_NAME": "buffalo_l",
    "FACE_MODEL_ROOT": "/tmp/insightface",
    "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "main.py"
    }
  ]
}
