
# 🛡️ Photo Identifier 環境變數範本
# 請複製此檔案並更名為 .env 進行設定
LOG_LEVEL=INFO

# --- [AI 核心設定] ---
# Google Cloud Vertex AI API Key
VERTEX_API_KEY=your_vertex_api_key_here

# --- [FastAPI 安全性] ---
# Session 加密金鑰 (請輸入一段長隨機字串)
SESSION_SECRET=yoursecretkeyhere_random_string

# --- [Google Drive OAuth 設定] ---
# 取得方式: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_PROJECT_NUMBER=123456789012

# 回導網址 (本地測試請用 http://localhost:8000/auth/callback)
# 部署到 Vercel 時需改為 https://your-app.vercel.app/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id

# --- [進階設定 (選擇性)] ---
# 指定 Token 儲存路徑
DRIVE_TOKEN_DIR=.secrets/drive_tokens

# 批次上傳限制（環境變數優先於 config.json）
# BATCH_UPLOAD_TOTAL_MAX_FILES 是使用者一次可先準備的總張數。
# BATCH_UPLOAD_BATCH_SIZE_* 是系統每批送進人臉分類服務的張數。
BATCH_UPLOAD_TOTAL_MAX_FILES=200
BATCH_UPLOAD_BATCH_SIZE=20
BATCH_UPLOAD_BATCH_SIZE_LOCAL=20
BATCH_UPLOAD_BATCH_SIZE_CLOUD=20
BATCH_UPLOAD_MAX_FILE_MB=30
BATCH_UPLOAD_MAX_TOTAL_MB=4000
LOCAL_UPLOAD_REQUEST_MAX_FILES=3
LOCAL_UPLOAD_REQUEST_MAX_TOTAL_MB=4
BATCH_UPLOAD_CONCURRENCY=5
# 本機模式可放寬一點，雲端模式則維持保守上限
BATCH_UPLOAD_CONCURRENCY_LOCAL_CAP=5
BATCH_UPLOAD_CONCURRENCY_CLOUD_CAP=3
BATCH_DOWNLOAD_MAX_MB=4000

# 人臉分群（透過獨立 classifier 服務）
FACE_CLUSTERING_ENABLED=true

# 批次狀態持久化
# auto: 在 Cloud Run / GCP 專案環境自動啟用 Firestore；本機沒有專案憑證時維持記憶體模式。
# firestore: 強制使用 Firestore。
# memory: 僅使用程序內記憶體，適合快速本機測試。
BATCH_STATE_BACKEND=auto
FIRESTORE_PROJECT_ID=vision-493709
FIRESTORE_DATABASE=(default)
# Vercel 等非 GCP 環境若要寫 Firestore，優先放 backend service account JSON；
# 舊的 FIRESTORE_SERVICE_ACCOUNT_JSON 暫時保留作為遷移 fallback。
PHOTOIDENTIFIER_BACKEND_SERVICE_ACCOUNT_JSON=
FIRESTORE_SERVICE_ACCOUNT_JSON=

# --- [獨立 InsightFace API] ---
# Vercel 僅在伺服器端讀取這兩個值；不要使用 NEXT_PUBLIC_ 前綴。
INSIGHT_API_URL=https://photoclassifier-project-number.asia-east1.run.app
INSIGHT_API_KEY=replace-with-the-same-secret-as-cloud-run-secret-manager
INSIGHT_API_CONNECT_TIMEOUT_SEC=20
INSIGHT_JOB_POLL_INTERVAL_SEC=1.0
INSIGHT_JOB_TIMEOUT_SEC=900
